{
  "name": "@bigmistqke/solid-grid-split",
  "version": "1.0.0-next.1",
  "description": "Solid pane-component based on grid-templates",
  "license": "MIT",
  "author": "bigmistqke",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmistqke/solid-grid-split.git"
  },
  "homepage": "https://github.com/bigmistqke/solid-grid-split#readme",
  "bugs": {
    "url": "https://github.com/bigmistqke/solid-grid-split/issues"
  },
  "files": [
    "dist"
  ],
  "private": false,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "dev": "vite serve dev",
    "build": "vite build .",
    "test": "concurrently pnpm:test:*",
    "test:client": "vitest --run",
    "test:ssr": "pnpm run test:client --mode ssr",
    "prepublishOnly": "pnpm build",
    "format": "prettier --ignore-path .gitignore -w \"src/**/*.{js,ts,json,css,tsx,jsx}\" \"dev/**/*.{js,ts,json,css,tsx,jsx}\"",
    "lint": "concurrently pnpm:lint:*",
    "lint:code": "eslint --ignore-path .gitignore --max-warnings 0 src/**/*.{js,ts,tsx,jsx}",
    "lint:types": "tsc --noEmit",
    "update-deps": "pnpm up -Li"
  },
  "dependencies": {
    "@bigmistqke/pointer": "^0.1.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.9",
    "solid-js": "^2.0.0-rc.9"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.30",
    "@solidjs/web": "2.0.0-rc.9",
    "@types/node": "^24.6.1",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "jsdom": "^24.0.0",
    "prettier": "3.0.0",
    "solid-js": "2.0.0-rc.9",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vite-plugin-dts": "5.1.0",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "solid"
  ],
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.0.0"
  }
}
